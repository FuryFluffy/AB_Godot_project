[resource]
script = ExtResource("1_family")
family_id = &"staff"
display_name = "Staff"
description = "Damaging Staff hits remove currently available Actions. Refuge ranks increase Action loss and Attack dice."
ranks = Array[WeaponRankDefinition]([ExtResource("2_rank_1"), ExtResource("3_rank_2"), ExtResource("4_rank_3")])
compatible_techniques = Array[ExtResource("5_ability_script")]([ExtResource("6_jaw_break")])
