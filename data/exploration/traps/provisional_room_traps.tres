[gd_resource type="Resource" script_class="RoomTrapProfile" format=3]

[ext_resource type="Script" path="res://scripts/exploration/traps/room_trap_profile.gd" id="profile"]
[ext_resource type="Script" path="res://scripts/exploration/traps/room_trap_definition.gd" id="definition"]
[ext_resource type="Resource" path="res://data/exploration/traps/poison.tres" id="poison"]
[ext_resource type="Resource" path="res://data/exploration/traps/corruption.tres" id="corruption"]
[ext_resource type="Resource" path="res://data/exploration/traps/alarm.tres" id="alarm"]

[resource]
script = ExtResource("profile")
profile_id = &"provisional_room_traps"
minimum_traps = 1
maximum_traps = 2
definitions = Array[ExtResource("definition")]([ExtResource("poison"), ExtResource("corruption"), ExtResource("alarm")])
