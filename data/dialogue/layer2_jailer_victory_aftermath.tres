[sub_resource type="Resource" id="Node_opening"]
script = ExtResource("2_node")
node_id = &"opening"
speaker_id = &"jailer"
speaker_name = "The Jailer"
text = "Door opening... No. Open means gone. Gone means hurt."
default_next_node_id = &"dungeon_exit"

[sub_resource type="Resource" id="Outcome_resolve_aftermath"]
script = ExtResource("3_outcome")
kind = 7
subject_id = &"layer_2_jailer_victory_aftermath"

[sub_resource type="Resource" id="Node_dungeon_exit"]
script = ExtResource("2_node")
node_id = &"dungeon_exit"
speaker_name = "Containment Landing"
text = "The Jailer falls at Layer 2's exit. The Dungeon continues inward, toward the Farthest Cell."
entry_outcomes = Array[ExtResource("3_outcome")]([SubResource("Outcome_resolve_aftermath")])

[resource]
script = ExtResource("1_definition")
dialogue_id = &"layer_2_jailer_victory_aftermath"
