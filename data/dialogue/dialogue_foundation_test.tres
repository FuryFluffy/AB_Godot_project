[sub_resource type="Resource" id="Outcome_calm_choice"]
script = ExtResource("7_outcome")
kind = 1
subject_id = &"dialogue_test_calm"

[sub_resource type="Resource" id="Choice_calm"]
script = ExtResource("3_choice")
choice_id = &"dialogue_test_calm"
text = "Examine the sealed cup carefully."
responder_id = &"lysandra"
next_node_id = &"item_gate"
outcomes = Array[ExtResource("7_outcome")]([SubResource("Outcome_calm_choice")])

[sub_resource type="Resource" id="Condition_mira_party"]
script = ExtResource("5_condition")
kind = 1
subject_id = &"mira"

[sub_resource type="Resource" id="Group_mira_party"]
script = ExtResource("4_group")
conditions = Array[ExtResource("5_condition")]([SubResource("Condition_mira_party")])

[sub_resource type="Resource" id="Outcome_mira_choice"]
script = ExtResource("7_outcome")
kind = 1
subject_id = &"dialogue_test_mira"

[sub_resource type="Resource" id="Choice_mira"]
script = ExtResource("3_choice")
choice_id = &"dialogue_test_mira"
text = "You know traps. What do you see?"
responder_id = &"lysandra"
conditions = SubResource("Group_mira_party")
failed_condition_presentation = 1
unavailable_reason = "Mira must be in the current party."
next_node_id = &"item_gate"
outcomes = Array[ExtResource("7_outcome")]([SubResource("Outcome_mira_choice")])

[sub_resource type="Resource" id="Node_start"]
script = ExtResource("2_node")
node_id = &"start"
speaker_id = &"narrator"
speaker_name = "The Castle"
left_actor_sprite = ExtResource("8_lysandra_stage")
text = "A shallow silver cup waits beneath a skin of red wax."
choices = Array[ExtResource("3_choice")]([SubResource("Choice_calm"), SubResource("Choice_mira")])

[sub_resource type="Resource" id="Outcome_consume_wine"]
script = ExtResource("7_outcome")
kind = 3
subject_id = &"l01_warm_wine_flask"

[sub_resource type="Resource" id="Outcome_set_wine_flag"]
script = ExtResource("7_outcome")
subject_id = &"dialogue_test_wine_offered"

[sub_resource type="Resource" id="Item_warm_wine"]
script = ExtResource("6_item")
item_id = &"l01_warm_wine_flask"
next_node_id = &"rejoin"
outcomes = Array[ExtResource("7_outcome")]([SubResource("Outcome_consume_wine"), SubResource("Outcome_set_wine_flag")])

[sub_resource type="Resource" id="Node_item_gate"]
script = ExtResource("2_node")
node_id = &"item_gate"
speaker_id = &"narrator"
speaker_name = "The Castle"
left_actor_sprite = ExtResource("8_lysandra_stage")
text = "The wax softens only when offered something already warmed."
item_policy = 3
item_options = Array[ExtResource("6_item")]([SubResource("Item_warm_wine")])

[sub_resource type="Resource" id="Node_rejoin"]
script = ExtResource("2_node")
node_id = &"rejoin"
speaker_id = &"narrator"
speaker_name = "The Castle"
left_actor_sprite = ExtResource("8_lysandra_stage")
text = "Both approaches lead here. The cup accepts the wine and releases its seal."
default_next_node_id = &"end"

[sub_resource type="Resource" id="Node_end"]
script = ExtResource("2_node")
node_id = &"end"
speaker_id = &"lysandra"
speaker_name = "Lysandra"
portrait = ExtResource("9_lysandra_portrait")
left_actor_sprite = ExtResource("8_lysandra_stage")
text = "Then the Castle can keep its cup."
mandatory = false

[resource]
script = ExtResource("1_definition")
dialogue_id = &"dialogue_foundation_test"
start_node_id = &"start"
trigger_kind = &"development"
trigger_id = &"event_room_screen_developer_test"
completion_kind = &"development"
completion_id = &"dialogue_foundation_test_completed"
nodes = Array[ExtResource("2_node")]([SubResource("Node_start"), SubResource("Node_item_gate"), SubResource("Node_rejoin"), SubResource("Node_end")])
