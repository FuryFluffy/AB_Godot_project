[gd_resource type="Resource" script_class="DialogueDefinition" format=3 uid="uid://dy28wuj7v1jsl"]

[ext_resource type="Script" uid="uid://cybq0i4o3rtqp" path="res://scripts/data/dialogue/dialogue_definition.gd" id="1_definition"]
[ext_resource type="Script" uid="uid://cupew1reqyia0" path="res://scripts/data/dialogue/dialogue_automatic_transition_definition.gd" id="2_iqlmj"]
[ext_resource type="Script" uid="uid://dt5s76iehjwb1" path="res://scripts/data/dialogue/dialogue_node_definition.gd" id="2_node"]
[ext_resource type="Script" uid="uid://bonhhpc7ts3c0" path="res://scripts/data/dialogue/dialogue_choice_definition.gd" id="3_choice"]
[ext_resource type="Script" uid="uid://dc31tn5aqd5jl" path="res://scripts/data/dialogue/dialogue_outcome_definition.gd" id="4_outcome"]
[ext_resource type="Script" uid="uid://by1deyw0gerap" path="res://scripts/data/dialogue/dialogue_item_option_definition.gd" id="5_kevc4"]
[ext_resource type="Texture2D" uid="uid://bgoh5rb2em84w" path="res://assets/characters/curated/lysandra/core_idle_front.png" id="5_lysandra_stage"]
[ext_resource type="Texture2D" uid="uid://ccbnd1r400hxw" path="res://assets/characters/curated/seraphine/core_idle_front.png" id="6_seraphine_stage"]

[sub_resource type="Resource" id="Node_final_words"]
script = ExtResource("2_node")
node_id = &"final_words"
speaker_id = &"blood_nun"
speaker_name = "Blood Nun"
left_actor_sprite = ExtResource("5_lysandra_stage")
right_actor_sprite = ExtResource("6_seraphine_stage")
text = "The lower dark will correct what I could not."
default_next_node_id = &"choose_passage"

[sub_resource type="Resource" id="Outcome_layer_1_completed"]
script = ExtResource("4_outcome")
scope = &"save"
subject_id = &"layer_1_completed"

[sub_resource type="Resource" id="Outcome_resolve_aftermath"]
script = ExtResource("4_outcome")
kind = 7
subject_id = &"layer_1_blood_nun_aftermath"

[sub_resource type="Resource" id="Choice_go_up"]
script = ExtResource("3_choice")
choice_id = &"layer_1_blood_nun_go_up"
text = "Go up — toward the unknown."
responder_id = &"lysandra"
outcomes = Array[ExtResource("4_outcome")]([SubResource("Outcome_layer_1_completed"), SubResource("Outcome_resolve_aftermath")])

[sub_resource type="Resource" id="Choice_go_down"]
script = ExtResource("3_choice")
choice_id = &"layer_1_blood_nun_go_down"
text = "Go down — toward the lower dark."
responder_id = &"lysandra"
outcomes = Array[ExtResource("4_outcome")]([SubResource("Outcome_layer_1_completed"), SubResource("Outcome_resolve_aftermath")])

[sub_resource type="Resource" id="Node_choose_passage"]
script = ExtResource("2_node")
node_id = &"choose_passage"
speaker_name = "Processing Chapel"
left_actor_sprite = ExtResource("5_lysandra_stage")
right_actor_sprite = ExtResource("6_seraphine_stage")
text = "Beyond the altar, one stair climbs into a harsher unknown. The other descends toward sheltering dark."
choices = Array[ExtResource("3_choice")]([SubResource("Choice_go_up"), SubResource("Choice_go_down")])

[resource]
script = ExtResource("1_definition")
dialogue_id = &"layer_1_blood_nun_aftermath"
start_node_id = &"final_words"
trigger_kind = &"encounter_aftermath"
trigger_id = &"layer_1_blood_nun"
completion_kind = &"resolved_interaction"
completion_id = &"layer_1_blood_nun_aftermath"
nodes = Array[ExtResource("2_node")]([SubResource("Node_final_words"), SubResource("Node_choose_passage")])
