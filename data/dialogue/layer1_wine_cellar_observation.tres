subject_id = &"hidden_feeding_flag_minor"

[sub_resource type="Resource" id="Outcome_offer_used_accept"]
script = ExtResource("4_outcome")
subject_id = &"wine_cellar_offer_used"

[sub_resource type="Resource" id="Choice_accept"]
script = ExtResource("3_choice")
choice_id = &"wine_cellar_accept"
text = "Accept the room's offered bottle."
next_node_id = &"accepted"
outcomes = Array[ExtResource("4_outcome")]([SubResource("Outcome_consume_offered_bottle"), SubResource("Outcome_restore_party"), SubResource("Outcome_resolve_plus_10"), SubResource("Outcome_corruption_plus_10"), SubResource("Outcome_hidden_feeding"), SubResource("Outcome_offer_used_accept")])

[sub_resource type="Resource" id="Outcome_offer_used_refuse"]
script = ExtResource("4_outcome")
subject_id = &"wine_cellar_offer_used"

[sub_resource type="Resource" id="Choice_refuse"]
script = ExtResource("3_choice")
choice_id = &"wine_cellar_refuse"
text = "Refuse. Leave the bottle where it is."
next_node_id = &"refused"
outcomes = Array[ExtResource("4_outcome")]([SubResource("Outcome_offer_used_refuse")])

[sub_resource type="Resource" id="Node_offer"]
script = ExtResource("2_node")
node_id = &"offer"
speaker_name = "Wine Cellar"
text = "The fire is warm. Three chairs wait beside three glasses, and one bottle has been uncorked as if the room expected you. Nothing moves except the wine's dark surface."
choices = Array[ExtResource("3_choice")]([SubResource("Choice_accept"), SubResource("Choice_refuse")])
mandatory = false

[sub_resource type="Resource" id="Node_accepted"]
script = ExtResource("2_node")
node_id = &"accepted"
speaker_name = "Wine Cellar"
text = "Warmth spreads too quickly to be natural. Wounds close, breath steadies, and the castle learns how readily comfort can resemble hunger."

[sub_resource type="Resource" id="Node_refused"]
script = ExtResource("2_node")
node_id = &"refused"
speaker_name = "Lysandra"
text = "We take what we choose. Not what the room pours for us."

[resource]
script = ExtResource("1_definition")
dialogue_id = &"layer_1_wine_cellar_observation"
start_node_id = &"offer"
trigger_kind = &"event_room_entry"
trigger_id = &"wine_cellar_warm_bottles"
completion_kind = &"flag"
completion_id = &"wine_cellar_offer_used"
nodes = Array[ExtResource("2_node")]([SubResource("Node_offer"), SubResource("Node_accepted"), SubResource("Node_refused")])
