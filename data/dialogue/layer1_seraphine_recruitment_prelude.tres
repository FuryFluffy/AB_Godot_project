[sub_resource type="Resource" id="Outcome_false_prayer_witnessed"]
script = ExtResource("4_outcome")
subject_id = &"layer_1_seraphine_false_prayer_witnessed"

[sub_resource type="Resource" id="Node_arrival_router"]
script = ExtResource("2_node")
node_id = &"arrival_router"
text = "The warded prayer answers in the wrong cadence."
entry_outcomes = Array[ExtResource("4_outcome")]([SubResource("Outcome_false_prayer_witnessed")])
automatic_transitions = Array[ExtResource("7_transition")]([SubResource("Transition_canonical_party"), SubResource("Transition_fallback")])

[sub_resource type="Resource" id="Choice_stand_with_seraphine"]
script = ExtResource("3_choice")
