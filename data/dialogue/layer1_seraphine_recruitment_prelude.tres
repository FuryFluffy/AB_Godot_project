region = Rect2(250, 0, 750, 1020)

[sub_resource type="Resource" id="Node_first_line"]
script = ExtResource("2_node")
node_id = &"first_line"
speaker_id = &"seraphine"
speaker_name = "Seraphine"
portrait = SubResource("AtlasTexture_seraphine_portrait")
left_actor_sprite = ExtResource("8_lysandra_stage")
right_actor_sprite = ExtResource("9_seraphine_stage")
text = "This place remembers prayer, but not mercy."
choices = Array[ExtResource("3_choice")]([SubResource("Choice_stand_with_seraphine")])

[resource]
script = ExtResource("1_definition")
dialogue_id = &"layer_1_seraphine_recruitment_prelude"
