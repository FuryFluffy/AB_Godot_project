[gd_resource type="Resource" script_class="EncounterTemplateDefinition" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/data/encounters/encounter_template_definition.gd" id="1_template"]
[ext_resource type="PackedScene" path="res://scenes/battle/battlefields/jailer_containment_landing_battlefield.tscn" id="2_field"]
[ext_resource type="Resource" path="res://data/enemy_ai/ruined_chapel_group_rulebook.tres" id="3_rulebook"]

[resource]
script = ExtResource("1_template")
template_id = &"jailer_containment_landing_boss"
display_name = "Jailer Containment Landing Encounter"
battlefield_scene = ExtResource("2_field")
enemy_group_rulebook = ExtResource("3_rulebook")
preview_enemy_ids = Array[StringName]([&"jailer"])
party_spawn_slot_ids = Array[StringName]([&"party_1", &"party_2", &"party_3"])
enemy_spawn_slot_ids = Array[StringName]([&"enemy_1"])
